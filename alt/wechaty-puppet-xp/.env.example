# =====================================================================
#  LEGACY engine (Wechaty + puppet-xp, WeChat 3.9.10.27) configuration
#  旧版引擎（Wechaty + puppet-xp，微信 3.9.10.27）配置文件
#  Put .env in THIS folder (alt/wechaty-puppet-xp/). 本引擎的 .env 放在本目录。
#  Copy this file to ".env" and fill in your values.
#  复制本文件为 ".env" 再填写。 .env 已在 .gitignore 中，不会被提交。
#  Lines starting with # are comments. 以 # 开头的是注释。
# =====================================================================

# ---------- Language / 语言 ----------
# zh-CN or en. Controls the default persona file, log text and memory prompts.
# zh-CN 或 en。决定默认人设文件、日志文案和记忆整理提示词的语言。
LANGUAGE=zh-CN

# Time zone for daily limits, active hours and memory dates.
# 时区：用于每日上限、活跃时段和记忆里的日期。
TIMEZONE=Asia/Shanghai

# ---------- AI (any OpenAI-compatible API) / AI 接口（任意 OpenAI 兼容接口） ----------
# Your API key. Required. Never commit it.
# 你的 API Key，必填。不要提交到仓库。
OPENAI_API_KEY=

# API base URL. Examples / 示例:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Others / 其他兼容服务: fill in the provider's /v1 endpoint 填服务商提供的 /v1 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name, as accepted by your provider. 模型名，以服务商支持的为准。
OPENAI_MODEL=gpt-4o-mini

# Max tokens per reply. 单次回复最大 token 数。
OPENAI_MAX_TOKENS=800

# Request timeout (ms). 请求超时（毫秒）。
OPENAI_TIMEOUT_MS=60000

# ---------- Bot identity & triggers / 机器人身份与触发 ----------
# The bot's display name used in the persona and as a trigger word.
# 机器人名字：写进人设，也是触发词（群里提到这个名字就会回复）。
BOT_NAME=小星

# Extra trigger words / nicknames, comma separated. Optional.
# 额外触发词或昵称，逗号分隔，可留空。
BOT_ALIASES=

# Persona file. Empty = shared ../../persona/persona.<LANGUAGE>.md
# 人设文件路径。留空则使用仓库根目录 persona/ 下对应语言的文件。
PERSONA_FILE=

# ---------- Reply scope / 回复范围 ----------
# Reply in groups when @-mentioned or when BOT_NAME / an alias appears.
# 群聊：被 @ 或消息里出现 BOT_NAME / 别名时回复。
REPLY_IN_GROUPS=true

# Reply to private (1:1) chats. Off by default.
# 私聊是否回复，默认关闭。
REPLY_IN_PRIVATE=false

# In private chats, only reply when the message contains BOT_NAME / an alias.
# 私聊时是否也要求消息里包含名字/别名才回复（false = 每条私聊都回）。
PRIVATE_REQUIRE_TRIGGER=true

# Only work in these groups (exact names, comma separated). Empty = all groups.
# 只在这些群工作（完整群名，逗号分隔）。留空 = 所有群。
ROOM_ALLOWLIST=

# Never work in these groups. 这些群完全不处理。
ROOM_BLOCKLIST=

# Recent messages kept as short-term context per chat. 每个会话保留的近期消息条数。
CONTEXT_MESSAGES=10

# Minimum gap between two replies in the same group (ms). Bursts are merged.
# 同一个群两次回复的最小间隔（毫秒）。连发的触发只回最新一条。
MIN_GAP_MS=3000

# Truncate replies longer than this. 回复超过这个字数会被截断。
MAX_REPLY_CHARS=300

# Ignore messages older than N minutes (replayed after login).
# 忽略 N 分钟前的旧消息（避免登录后补推的消息被回复）。
STALE_MESSAGE_MIN=10

# ---------- Proactive chat / 主动聊天 ----------
# Off by default. When on, the bot may say one line in a group that has gone quiet.
# 默认关闭。开启后，群里安静一阵子时机器人可能主动说一句。
PROACTIVE_ENABLED=false
# Only within these hours (local TIMEZONE). 仅在此时段内（按 TIMEZONE）。
PROACTIVE_HOURS=09:00-22:30
# Group must be quiet for at least N minutes. 群需安静至少 N 分钟。
PROACTIVE_QUIET_MIN=45
# Wait at least N minutes between two proactive lines in one group. 同一群两次主动发言的冷却（分钟）。
PROACTIVE_COOLDOWN_MIN=180
# At most N proactive lines per group per day. 每个群每天最多主动发言次数。
PROACTIVE_MAX_PER_DAY=3
# Probability (0-1) to speak when all conditions are met. 满足条件时实际发言的概率（0-1）。
PROACTIVE_PROB=0.3
# How often to check (minutes). 检查频率（分钟）。
PROACTIVE_CHECK_MIN=10

# ---------- Memory & knowledge base / 记忆与知识库 ----------
# Archive group messages locally and summarize them into long-term memory.
# 在本地归档群消息，并定期整理成长期记忆。关闭后不再写入 kb/。
MEMORY_ENABLED=true
# Summarize every N minutes. 每 N 分钟整理一次。
MEMORY_INTERVAL_MIN=30
# Only summarize a group after N new messages. 某个群新增 N 条消息后才整理。
MEMORY_MIN_NEW=10
# Search past messages from the last N days. 检索最近 N 天的历史消息。
MEMORY_SEARCH_DAYS=30
# Knowledge base folder (relative to project root). 知识库目录（相对项目根目录）。
KB_DIR=kb

# ---------- Logs / 日志 ----------
LOG_FILE=logs/bot.log
