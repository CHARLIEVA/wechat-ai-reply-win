# =====================================================================
#  wechat-ai-reply-win configuration (main engine: wxauto4 + WeChat 4.x)
#  配置文件（主引擎：wxauto4 + 微信 4.x）
#  Copy this file to ".env" in the same folder and fill in your values.
#  复制本文件为同目录下的 ".env" 再填写。.env 已被 git 忽略，不会被提交。
#  Lines starting with # are comments. 以 # 开头的是注释。
# =====================================================================

# ---------- Language / 语言 ----------
# zh-CN or en: picks persona/persona.<LANGUAGE>.md and the memory prompt language.
# zh-CN 或 en：决定使用哪个人设文件，以及记忆整理提示词的语言。
LANGUAGE=zh-CN

# ---------- AI (any OpenAI-compatible API) / AI 接口（任意 OpenAI 兼容接口） ----------
# Your API key. Required. Never commit or share it.
# 你的 API Key，必填。不要提交或分享。
OPENAI_API_KEY=

# API base URL. Examples / 示例:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Others / 其他兼容服务: the provider's /v1 endpoint / 服务商提供的 /v1 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name, as accepted by your provider. 模型名，以服务商支持的为准。
OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds. 请求超时（秒）。
OPENAI_TIMEOUT_SEC=90

# ---------- Bot identity & triggers / 机器人身份与触发 ----------
# Bot name: used in the persona ({{BOT_NAME}}) and as a trigger word.
# Messages containing it, or "@<your WeChat nickname>", get a reply.
# 机器人名字：替换人设里的 {{BOT_NAME}}，同时是触发词。
# 消息里包含这个名字，或 "@你的微信昵称" 时会回复。
BOT_NAME=小星

# Extra trigger words, comma separated. Optional. 额外触发词，逗号分隔，可留空。
BOT_ALIASES=

# Persona file. Empty = persona/persona.<LANGUAGE>.md. Re-read on every reply.
# 人设文件路径。留空 = persona/ 下对应语言的文件。每次回复都重新读取。
PERSONA_FILE=

# ---------- Reply scope / 回复范围 ----------
# Reply in groups when triggered. 群聊被触发时回复。
REPLY_IN_GROUPS=true

# Reply to private (1:1) chats. Off by default. 是否回复私聊，默认关闭。
REPLY_IN_PRIVATE=false

# Private chats also need a trigger word (false = reply to every private message).
# 私聊也要求包含触发词（false = 每条私聊都回）。
PRIVATE_REQUIRE_TRIGGER=true

# Only handle these chats (exact names, comma separated). Empty = all.
# 只处理这些会话（完整名称，逗号分隔）。留空 = 全部。
CHAT_ALLOWLIST=

# Never handle these chats. 这些会话完全不处理。
CHAT_BLOCKLIST=

# Past exchanges of the SAME chat included as context. 带入上下文的本会话历史问答条数。
CONTEXT_MESSAGES=10

# Truncate replies longer than this. 回复超过这个字数会被截断。
MAX_REPLY_CHARS=300

# The same sender + same text in the same chat is answered once within N hours.
# 同一会话、同一人、同样内容，N 小时内只回一次（重启也生效）。
DEDUP_HOURS=12

# How often to poll WeChat for new messages (seconds). 轮询新消息的间隔（秒）。
POLL_SEC=2

# ---------- Memory / 记忆 ----------
# Summarize each chat's exchanges into kb/chats/<chat>/memory.md (sent to your AI provider).
# 把每个会话的问答整理成 kb/chats/<会话>/memory.md（内容会发给 AI 服务商）。
MEMORY_ENABLED=true
# Summarize after every N new exchanges in a chat. 某会话每新增 N 条问答整理一次。
MEMORY_EVERY_N=10

# ---------- Proactive chat (experimental) / 主动聊天（实验性） ----------
# Off by default. Only groups listed in PROACTIVE_CHATS are considered.
# 默认关闭。只对 PROACTIVE_CHATS 里列出的群生效。
PROACTIVE_ENABLED=false
# Exact group names, comma separated. 完整群名，逗号分隔。
PROACTIVE_CHATS=
# Active hours (PC local time). 活跃时段（本机时间）。
PROACTIVE_HOURS=09:00-22:30
# Group must be quiet for at least N minutes. 群需安静至少 N 分钟。
PROACTIVE_QUIET_MIN=45
# Minutes between two proactive lines in one group. 同一群两次主动发言的冷却（分钟）。
PROACTIVE_COOLDOWN_MIN=180
# Max proactive lines per group per day. 每个群每天最多主动发言次数。
PROACTIVE_MAX_PER_DAY=3
# Probability (0-1) to speak when all conditions hold. 满足条件时实际发言的概率（0-1）。
PROACTIVE_PROB=0.3
# Check interval (minutes). 检查间隔（分钟）。
PROACTIVE_CHECK_MIN=10

# ---------- Storage / 存储 ----------
# Knowledge base folder, relative to the project root. 知识库目录（相对项目根目录）。
KB_DIR=kb
